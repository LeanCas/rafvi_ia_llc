<section class="rafvi-hero rafvi-bg-white" id="{{ section.id }}">
  <div class="rafvi-container rafvi-hero__grid">
    <div class="rafvi-hero__content rafvi-reveal">
      {%- if section.settings.badge != blank -%}
        <span class="rafvi-badge">{{ section.settings.badge }}</span>
      {%- endif -%}

      <h1 class="rafvi-title">{{ section.settings.heading }}</h1>

      {%- if section.settings.text != blank -%}
        <p class="rafvi-subtitle">{{ section.settings.text }}</p>
      {%- endif -%}

      <div class="rafvi-cta-row">
        {%- if section.settings.primary_cta_label != blank -%}
          <a href="{{ section.settings.primary_cta_link | default: '#solicitar-demo' }}" class="rafvi-btn rafvi-btn--primary">
            {{ section.settings.primary_cta_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_cta_label != blank -%}
          <a href="{{ section.settings.secondary_cta_link | default: '#como-funciona' }}" class="rafvi-btn rafvi-btn--secondary">
            {{ section.settings.secondary_cta_label }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.settings.microcopy != blank -%}
        <p class="rafvi-microcopy">{{ section.settings.microcopy }}</p>
      {%- endif -%}
    </div>

    <div class="rafvi-hero__visual rafvi-reveal" aria-hidden="true">
      <div class="rafvi-console">
        <div class="rafvi-console__bar">
          <i></i><i></i><i></i>
          <span class="rafvi-console__bar-title">RAFVI &middot; Panel de conversaciones</span>
          <span class="rafvi-console__live"><b></b> En vivo</span>
        </div>
        <div class="rafvi-console__body">
          <div class="rafvi-console__row">
            <div class="rafvi-console__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <div class="rafvi-console__text">
              <span class="rafvi-console__sender">Llamada entrante &middot; Cliente</span>
              <span class="rafvi-console__snippet">&ldquo;Quería consultar disponibilidad de turnos.&rdquo;</span>
            </div>
            <span class="rafvi-console__status">Atendido</span>
          </div>

          <div class="rafvi-console__row">
            <div class="rafvi-console__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="m22 6-10 7L2 6"/></svg>
            </div>
            <div class="rafvi-console__text">
              <span class="rafvi-console__sender">Email &middot; Lead nuevo</span>
              <span class="rafvi-console__snippet">&ldquo;Me gustaría recibir más información.&rdquo;</span>
            </div>
            <span class="rafvi-console__status">Respondido</span>
          </div>

          <div class="rafvi-console__typing">
            <div class="rafvi-console__icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
            </div>
            <span class="rafvi-console__typing-label">WhatsApp &middot; el agente está respondiendo</span>
            <span class="rafvi-console__dots"><span></span><span></span><span></span></span>
          </div>
        </div>
        <div class="rafvi-console__footer">
          <b></b>
          Agente RAFVI activo
          <span class="rafvi-console__metric">Con supervisión humana</span>
        </div>
      </div>

      <div class="rafvi-hero__float">
        <span class="rafvi-hero__float-num">24/7</span>
        <span class="rafvi-hero__float-label">Atención<br>continua</span>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.rafvi-hero {
  position: relative;
  padding: 120px 0 104px;
  overflow: hidden;
}
.rafvi-hero .rafvi-container { max-width: 1280px; }

.rafvi-hero__grid {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1.02fr 1fr;
  gap: 72px;
  align-items: center;
}
.rafvi-hero::before {
  content: '';
  position: absolute;
  top: -160px;
  right: -120px;
  width: 620px;
  height: 620px;
  background: var(--rafvi-gradient);
  filter: blur(120px);
  opacity: 0.16;
  border-radius: 50%;
  pointer-events: none;
}
.rafvi-hero__content .rafvi-cta-row { justify-content: flex-start; }

@media screen and (max-width: 989px) {
  .rafvi-hero { padding: 64px 0 72px; }
  .rafvi-hero__grid { grid-template-columns: 1fr; gap: 48px; }
  .rafvi-hero__visual { order: -1; }
}

.rafvi-hero__visual { position: relative; }

.rafvi-console {
  position: relative;
  z-index: 1;
  background: #fff;
  border: 1px solid var(--rafvi-border);
  border-radius: var(--rafvi-radius-xl);
  box-shadow: var(--rafvi-shadow-lg);
  overflow: hidden;
}
.rafvi-console__bar {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 16px 20px;
  background: var(--rafvi-bg-soft);
  border-bottom: 1px solid var(--rafvi-border);
}
.rafvi-console__bar i {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--rafvi-border);
}
.rafvi-console__bar-title {
  margin-left: 10px;
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--rafvi-text-secondary);
}
.rafvi-console__live {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--rafvi-blue);
  text-transform: uppercase;
}
.rafvi-console__live b {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--rafvi-cyan);
  box-shadow: 0 0 0 0 rgba(20, 200, 245, 0.5);
  animation: rafviPulse 2.4s var(--rafvi-ease) infinite;
}
.rafvi-console__body {
  padding: 14px;
  display: grid;
  gap: 10px;
}
.rafvi-console__row {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 15px 14px;
  border-radius: var(--rafvi-radius-md);
  background: var(--rafvi-bg-soft);
  border: 1px solid transparent;
  transition: border-color 0.2s ease, background 0.2s ease;
}
.rafvi-console__row:hover {
  border-color: var(--rafvi-border);
  background: #fff;
}
.rafvi-console__icon {
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  border-radius: 11px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border: 1px solid var(--rafvi-border);
  color: var(--rafvi-blue);
  overflow: hidden;
}
.rafvi-console__icon svg { width: 18px; height: 18px; flex-shrink: 0; }

.rafvi-console__text {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
  flex: 1;
}
.rafvi-console__sender {
  font-size: 1.28rem;
  font-weight: 700;
  color: var(--rafvi-text);
}
.rafvi-console__snippet {
  font-size: 1.28rem;
  font-weight: 500;
  color: var(--rafvi-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.rafvi-console__status {
  flex-shrink: 0;
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 0.01em;
  color: var(--rafvi-blue);
  background: var(--rafvi-blue-soft);
  padding: 5px 12px;
  border-radius: 999px;
}
.rafvi-console__typing {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 15px 14px;
  border-radius: var(--rafvi-radius-md);
  background: linear-gradient(135deg, rgba(7, 91, 216, 0.06), rgba(20, 200, 245, 0.06));
  border: 1px solid var(--rafvi-blue-soft);
}
.rafvi-console__typing-label {
  font-size: 1.24rem;
  font-weight: 600;
  color: var(--rafvi-blue);
}
.rafvi-console__dots {
  display: inline-flex;
  gap: 5px;
  margin-left: auto;
}
.rafvi-console__dots span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--rafvi-electric);
  opacity: 0.4;
  animation: rafviTyping 1.4s var(--rafvi-ease) infinite;
}
.rafvi-console__dots span:nth-child(2) { animation-delay: 0.2s; }
.rafvi-console__dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes rafviTyping {
  0%, 60%, 100% { opacity: 0.35; transform: translateY(0); }
  30% { opacity: 1; transform: translateY(-3px); }
}

.rafvi-console__footer {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 15px 20px;
  border-top: 1px solid var(--rafvi-border);
  font-size: 1.22rem;
  font-weight: 600;
  color: var(--rafvi-text-secondary);
  background: var(--rafvi-bg-soft);
}
.rafvi-console__footer b {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--rafvi-cyan);
  box-shadow: 0 0 0 4px rgba(20, 200, 245, 0.18);
}
.rafvi-console__metric {
  margin-left: auto;
  color: var(--rafvi-text);
  font-weight: 700;
}

.rafvi-hero__float {
  position: absolute;
  left: -28px;
  bottom: 34px;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 18px;
  background: #fff;
  border: 1px solid var(--rafvi-border);
  border-radius: var(--rafvi-radius-md);
  box-shadow: var(--rafvi-shadow);
}
.rafvi-hero__float-num {
  font-size: 2.2rem;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.03em;
  color: var(--rafvi-navy);
  line-height: 1;
}
.rafvi-hero__float-label {
  font-size: 1.18rem;
  font-weight: 600;
  line-height: 1.35;
  color: var(--rafvi-text-secondary);
}

@media screen and (max-width: 480px) {
  .rafvi-hero__float { left: 12px; bottom: -20px; }
}

@media (prefers-reduced-motion: reduce) {
  .rafvi-console__live b,
  .rafvi-console__dots span { animation: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "RAFVI · Hero",
  "settings": [
    { "type": "text", "id": "badge", "label": "Badge", "default": "Agentes de IA para empresas" },
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Automatizá conversaciones. Escalá tu empresa." },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto de apoyo",
      "default": "RAFVI conecta agentes de inteligencia artificial con llamadas, correos y mensajes para que tu empresa pueda responder más rápido, atender más clientes y operar 24/7."
    },
    { "type": "text", "id": "primary_cta_label", "label": "CTA principal", "default": "Solicitar demo" },
    { "type": "url", "id": "primary_cta_link", "label": "Link CTA principal" },
    { "type": "text", "id": "secondary_cta_label", "label": "CTA secundaria", "default": "Ver cómo funciona" },
    { "type": "url", "id": "secondary_cta_link", "label": "Link CTA secundaria" },
    { "type": "text", "id": "microcopy", "label": "Microcopy", "default": "Automatización personalizada para los canales y procesos de tu empresa." }
  ],
  "presets": [
    { "name": "RAFVI · Hero" }
  ]
}
{% endschema %}
