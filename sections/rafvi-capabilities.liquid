<section class="rafvi-section rafvi-bg-white" id="capacidades">
  <div class="rafvi-container">
    <div class="rafvi-header">
      <span class="rafvi-eyebrow">Capacidades</span>
      <h2 class="rafvi-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="rafvi-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="rafvi-grid">
      {%- for block in section.blocks -%}
        <div class="rafvi-card rafvi-reveal" {{ block.shopify_attributes }}>
          <div class="rafvi-card__icon">{{ block.settings.icon }}</div>
          <h3 class="rafvi-card__title">{{ block.settings.title }}</h3>
          <p class="rafvi-card__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RAFVI · Capacidades",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Un agente de IA para cada conversación" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Desde una llamada hasta un correo o un mensaje, RAFVI ayuda a mantener tu operación activa y tus clientes atendidos."
    }
  ],
  "blocks": [
    {
      "type": "capability",
      "name": "Capacidad",
      "settings": [
        { "type": "html", "id": "icon", "label": "Icono (SVG)", "default": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='9'/></svg>" },
        { "type": "text", "id": "title", "label": "Título", "default": "Llamadas con IA" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Atendé consultas, calificá contactos, derivá llamadas y automatizá tareas telefónicas." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "capability", "settings": { "title": "Llamadas con IA", "text": "Atendé consultas, calificá contactos, derivá llamadas y automatizá tareas telefónicas.", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z'/></svg>" } },
      { "type": "capability", "settings": { "title": "Emails automáticos", "text": "Interpretá correos entrantes y respondé según el contexto, las reglas y la información de tu empresa.", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M4 4h16v16H4z'/><path d='m22 6-10 7L2 6'/></svg>" } },
      { "type": "capability", "settings": { "title": "Mensajería", "text": "Automatizá conversaciones por chat y canales de mensajería desde un mismo sistema.", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z'/></svg>" } },
      { "type": "capability", "settings": { "title": "Seguimiento comercial", "text": "Mantené el contacto con leads y oportunidades sin depender de seguimientos manuales.", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M3 3v18h18'/><path d='M7 15l4-4 3 3 5-6'/></svg>" } },
      { "type": "capability", "settings": { "title": "Agendamiento", "text": "Coordiná reuniones, reservas o turnos automáticamente.", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg>" } },
      { "type": "capability", "settings": { "title": "Soporte al cliente", "text": "Resolvé preguntas frecuentes y derivá los casos que necesitan intervención humana.", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z'/></svg>" } }
    ]
  }
}
{% endschema %}
