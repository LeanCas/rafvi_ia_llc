<section class="rafvi-section rafvi-bg-soft" id="control-humano">
  <div class="rafvi-container">
    <div class="rafvi-columns">
      <div class="rafvi-reveal">
        <span class="rafvi-eyebrow">Control y personalización</span>
        <h2 class="rafvi-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="rafvi-subtitle" style="text-align:left;">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <ul class="rafvi-checklist rafvi-reveal">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RAFVI · Control humano",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Automatización sin perder el control" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Definí cómo responde tu agente, qué información puede utilizar y cuándo debe intervenir una persona."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ítem",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Tono de voz personalizado" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "item", "settings": { "label": "Tono de voz personalizado" } },
      { "type": "item", "settings": { "label": "Reglas de negocio" } },
      { "type": "item", "settings": { "label": "Reglas de escalamiento" } },
      { "type": "item", "settings": { "label": "Horarios de atención" } },
      { "type": "item", "settings": { "label": "Fuentes de conocimiento" } },
      { "type": "item", "settings": { "label": "Acciones permitidas y restringidas" } },
      { "type": "item", "settings": { "label": "Derivación a un humano" } },
      { "type": "item", "settings": { "label": "Historial de conversaciones" } }
    ]
  },
  "presets": [
    { "name": "RAFVI · Control humano" }
  ]
}
{% endschema %}
