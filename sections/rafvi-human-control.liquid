<section class="rafvi-section rafvi-bg-soft" id="control-humano">
  <div class="rafvi-container">
    <div class="rafvi-columns">
      <div class="rafvi-reveal">
        <span class="rafvi-eyebrow">Control y personalización</span>
        <h2 class="rafvi-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="rafvi-subtitle rafvi-subtitle--left">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <ul class="rafvi-checklist">
        {%- for block in section.blocks -%}
          <li class="rafvi-reveal" {{ block.shopify_attributes }}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="18" height="18"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
.rafvi-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 72px;
  align-items: center;
}
@media screen and (max-width: 989px) {
  .rafvi-columns { grid-template-columns: 1fr; gap: 44px; }
}
.rafvi-subtitle--left { text-align: left; }

.rafvi-checklist {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 4px;
  grid-template-columns: repeat(2, 1fr);
}
@media screen and (max-width: 589px) {
  .rafvi-checklist { grid-template-columns: 1fr; }
}
.rafvi-checklist li {
  display: flex;
  align-items: center;
  gap: 14px;
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--rafvi-text);
  padding: 16px 4px;
  border-bottom: 1px solid var(--rafvi-border);
}
.rafvi-checklist li:nth-last-child(-n + 2) { border-bottom: none; }
.rafvi-checklist svg {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  color: var(--rafvi-blue);
  padding: 7px;
  border-radius: 50%;
  background: var(--rafvi-blue-soft);
  box-sizing: content-box;
}
{% endstylesheet %}

{% schema %}
{
  "name": "RAFVI · Control humano",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Automatización sin perder el control" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Definí cómo responde tu agente, qué información puede utilizar y cuándo debe intervenir una persona."
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Ítem",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Tono de voz personalizado" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RAFVI · Control humano",
      "blocks": [
        { "type": "item", "settings": { "label": "Tono de voz personalizado" } },
        { "type": "item", "settings": { "label": "Reglas de negocio" } },
        { "type": "item", "settings": { "label": "Reglas de escalamiento" } },
        { "type": "item", "settings": { "label": "Horarios de atención" } },
        { "type": "item", "settings": { "label": "Fuentes de conocimiento" } },
        { "type": "item", "settings": { "label": "Acciones permitidas y restringidas" } },
        { "type": "item", "settings": { "label": "Derivación a un humano" } },
        { "type": "item", "settings": { "label": "Historial de conversaciones" } }
      ]
    }
  ]
}
{% endschema %}
