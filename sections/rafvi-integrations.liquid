<section class="rafvi-section rafvi-bg-white" id="integraciones">
  <div class="rafvi-container">
    <div class="rafvi-header rafvi-reveal">
      <span class="rafvi-eyebrow">Integraciones</span>
      <h2 class="rafvi-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="rafvi-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="rafvi-grid rafvi-grid--4">
      {%- for block in section.blocks -%}
        <div class="rafvi-card rafvi-reveal" {{ block.shopify_attributes }}>
          <div class="rafvi-card__icon">{{ block.settings.icon }}</div>
          <h3 class="rafvi-card__title" style="font-size:1.7rem;">{{ block.settings.title }}</h3>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="rafvi-subtitle rafvi-integrations__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .rafvi-integrations__footnote {
    text-align: center;
    max-width: 640px;
    margin: 44px auto 0;
    font-size: 1.5rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RAFVI · Integraciones",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Conectado con tu operación" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo" },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Nota al pie",
      "default": "RAFVI puede adaptarse a los canales, herramientas y procesos que ya forman parte de tu empresa."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Categoría",
      "settings": [
        { "type": "html", "id": "icon", "label": "Icono (SVG)", "default": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='12' r='9'/></svg>" },
        { "type": "text", "id": "title", "label": "Título", "default": "Mensajería" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RAFVI · Integraciones",
      "blocks": [
        { "type": "category", "settings": { "title": "Mensajería", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z'/></svg>" } },
        { "type": "category", "settings": { "title": "Email", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='M4 4h16v16H4z'/><path d='m22 6-10 7L2 6'/></svg>" } },
        { "type": "category", "settings": { "title": "Calendario", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='3' y='4' width='18' height='18' rx='2'/><path d='M16 2v4M8 2v4M3 10h18'/></svg>" } },
        { "type": "category", "settings": { "title": "CRM", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='12' cy='7' r='4'/><path d='M5.5 21a6.5 6.5 0 0 1 13 0'/></svg>" } },
        { "type": "category", "settings": { "title": "Ecommerce", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><circle cx='9' cy='21' r='1'/><circle cx='20' cy='21' r='1'/><path d='M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6'/></svg>" } },
        { "type": "category", "settings": { "title": "APIs", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><path d='m18 16 4-4-4-4M6 8l-4 4 4 4M14.5 4l-5 16'/></svg>" } },
        { "type": "category", "settings": { "title": "Sistemas internos", "icon": "<svg viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2'><rect x='4' y='4' width='16' height='16' rx='2'/><path d='M9 9h6v6H9z'/></svg>" } }
      ]
    }
  ]
}
{% endschema %}
