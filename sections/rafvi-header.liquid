    { "type": "range", "id": "logo_height", "label": "Alto del logo", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "text", "id": "logo_text", "label": "Texto (si no hay logo)", "default": "RAFVI IA LLC" },
    { "type": "text", "id": "cta_label", "label": "Texto del CTA", "default": "Solicitar demo" },
    { "type": "url", "id": "cta_link", "label": "Link del CTA" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Producto" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
