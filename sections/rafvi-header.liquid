<script src="{{ 'rafvi-header.js' | asset_url }}" defer="defer"></script>

<header class="rafvi-navbar rafvi-bg-white" data-rafvi-header>
  <div class="rafvi-container rafvi-navbar__inner">
    <a href="{{ routes.root_url }}" class="rafvi-navbar__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ section.settings.logo.alt | escape | default: shop.name }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          style="height: {{ section.settings.logo_height }}px; width: auto;"
        >
      {%- else -%}
        <span class="rafvi-navbar__wordmark">{{ section.settings.logo_text | default: shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="rafvi-navbar__links" aria-label="Navegación principal">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <div class="rafvi-navbar__actions">
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: '#solicitar-demo' }}" class="rafvi-btn rafvi-btn--primary rafvi-navbar__cta">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}

      <button type="button" class="rafvi-navbar__toggle" data-rafvi-menu-toggle aria-expanded="false" aria-controls="RafviMobileMenu" aria-label="Abrir menú">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div class="rafvi-navbar__mobile" id="RafviMobileMenu" data-rafvi-menu-panel>
    <nav aria-label="Navegación móvil">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          <a href="{{ block.settings.url | default: '#' }}">{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.cta_label != blank -%}
        <a href="{{ section.settings.cta_link | default: '#solicitar-demo' }}" class="rafvi-btn rafvi-btn--primary">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </nav>
  </div>
</header>

<style>
  .rafvi-navbar {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid transparent;
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .rafvi-navbar.is-scrolled {
    border-color: var(--rafvi-border);
    box-shadow: 0 8px 24px rgba(7, 30, 65, 0.06);
  }

  .rafvi-navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 32px;
  }

  .rafvi-navbar__logo {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .rafvi-navbar__wordmark {
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 2rem;
    color: var(--rafvi-navy);
  }

  .rafvi-navbar__links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .rafvi-navbar__links a {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--rafvi-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .rafvi-navbar__links a:hover {
    color: var(--rafvi-blue);
  }

  .rafvi-navbar__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .rafvi-navbar__cta {
    padding: 12px 24px;
    font-size: 1.4rem;
  }

  .rafvi-navbar__toggle {
    display: none;
    background: none;
    border: none;
    padding: 6px;
    cursor: pointer;
    color: var(--rafvi-text);
  }

  .rafvi-navbar__toggle svg {
    width: 26px;
    height: 26px;
  }

  .rafvi-navbar__mobile {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 12px 32px 24px;
    border-top: 1px solid var(--rafvi-border);
  }

  .rafvi-navbar__mobile.is-open {
    display: flex;
  }

  .rafvi-navbar__mobile a {
    padding: 12px 0;
    font-size: 1.6rem;
    font-weight: 600;
    color: var(--rafvi-text);
    text-decoration: none;
    border-bottom: 1px solid var(--rafvi-border);
  }

  .rafvi-navbar__mobile .rafvi-btn {
    margin-top: 12px;
    justify-content: center;
  }

  @media screen and (max-width: 989px) {
    .rafvi-navbar__links,
    .rafvi-navbar__cta {
      display: none;
    }

    .rafvi-navbar__toggle {
      display: inline-flex;
    }

    .rafvi-navbar__inner {
      padding: 16px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "RAFVI · Navbar",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_height", "label": "Alto del logo", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "text", "id": "logo_text", "label": "Texto (si no hay logo)", "default": "RAFVI IA LLC" },
    { "type": "text", "id": "cta_label", "label": "Texto del CTA", "default": "Solicitar demo" },
    { "type": "url", "id": "cta_link", "label": "Link del CTA" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Producto" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
