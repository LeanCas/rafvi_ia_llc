<section class="rafvi-section rafvi-bg-navy" id="canales">
  <div class="rafvi-container">
    <div class="rafvi-header rafvi-reveal">
      <h2 class="rafvi-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="rafvi-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="rafvi-hub rafvi-reveal">
      <svg class="rafvi-hub__wires" viewBox="0 0 800 440" preserveAspectRatio="none" aria-hidden="true">
        <g class="rafvi-hub__wire-base">
          <line x1="130" y1="70" x2="400" y2="220"/>
          <line x1="400" y1="70" x2="400" y2="220"/>
          <line x1="670" y1="70" x2="400" y2="220"/>
          <line x1="130" y1="370" x2="400" y2="220"/>
          <line x1="400" y1="370" x2="400" y2="220"/>
          <line x1="670" y1="370" x2="400" y2="220"/>
        </g>
        <g class="rafvi-hub__wire-signal">
          <line x1="130" y1="70" x2="400" y2="220"/>
          <line x1="400" y1="70" x2="400" y2="220" style="animation-delay:.4s"/>
          <line x1="670" y1="70" x2="400" y2="220" style="animation-delay:.8s"/>
          <line x1="130" y1="370" x2="400" y2="220" style="animation-delay:1.2s"/>
          <line x1="400" y1="370" x2="400" y2="220" style="animation-delay:1.6s"/>
          <line x1="670" y1="370" x2="400" y2="220" style="animation-delay:2s"/>
        </g>
      </svg>

      <div class="rafvi-hub__core">
        <span class="rafvi-hub__core-mark">RAFVI</span>
        <span class="rafvi-hub__core-sub">Agente de IA</span>
      </div>

      <ul class="rafvi-hub__nodes">
        {%- for block in section.blocks -%}
          {%- assign label_down = block.settings.label | downcase -%}
          <li class="rafvi-hub__node rafvi-reveal" {{ block.shopify_attributes }}>
            <span class="rafvi-hub__node-icon">
              {%- case label_down -%}
                {%- when 'teléfono', 'telefono', 'llamadas', 'llamada', 'voz' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                {%- when 'email', 'correo', 'mail', 'correos' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="m22 6-10 7L2 6"/></svg>
                {%- when 'whatsapp', 'chat', 'mensajería', 'mensajeria', 'mensajes' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                {%- when 'web chat', 'webchat', 'web' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="14" rx="2"/><path d="M8 21h8M12 18v3"/></svg>
                {%- when 'sms' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                {%- when 'crm' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="7" r="4"/><path d="M5.5 21a6.5 6.5 0 0 1 13 0"/></svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/></svg>
              {%- endcase -%}
            </span>
            <span class="rafvi-hub__node-label">{{ block.settings.label }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  .rafvi-hub {
    position: relative;
    max-width: 820px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto auto;
    gap: 20px 24px;
    align-items: center;
  }

  .rafvi-hub__wires {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .rafvi-hub__wire-base line {
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1.5;
  }

  .rafvi-hub__wire-signal line {
    stroke: var(--rafvi-cyan);
    stroke-width: 2;
    stroke-dasharray: 5 14;
    stroke-linecap: round;
    opacity: 0.9;
    animation: rafviSignal 2.6s linear infinite;
  }

  @keyframes rafviSignal {
    to { stroke-dashoffset: -190; }
  }

  .rafvi-hub__nodes {
    display: contents;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .rafvi-hub__node {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: var(--rafvi-radius-md);
    color: #fff;
    font-weight: 600;
    font-size: 1.45rem;
    backdrop-filter: blur(4px);
    transition: transform 0.2s var(--rafvi-ease), background 0.2s ease, border-color 0.2s ease;
  }

  .rafvi-hub__node:hover {
    transform: translateY(-3px);
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(20, 200, 245, 0.5);
  }

  /* row 1 nodes -> children 1..3, row 3 nodes -> children 4..6 */
  .rafvi-hub__node:nth-child(1) { grid-area: 1 / 1; }
  .rafvi-hub__node:nth-child(2) { grid-area: 1 / 2; }
  .rafvi-hub__node:nth-child(3) { grid-area: 1 / 3; }
  .rafvi-hub__node:nth-child(4) { grid-area: 3 / 1; }
  .rafvi-hub__node:nth-child(5) { grid-area: 3 / 2; }
  .rafvi-hub__node:nth-child(6) { grid-area: 3 / 3; }
  .rafvi-hub__node:nth-child(n+7) { display: none; }

  .rafvi-hub__node-icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(20, 200, 245, 0.12);
    color: var(--rafvi-cyan);
  }

  .rafvi-hub__node-icon svg {
    width: 17px;
    height: 17px;
  }

  .rafvi-hub__core {
    position: relative;
    z-index: 2;
    grid-area: 2 / 1 / 3 / 4;
    justify-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 148px;
    height: 148px;
    border-radius: 50%;
    background: var(--rafvi-gradient-button);
    box-shadow: 0 20px 50px rgba(11, 142, 255, 0.4);
  }

  .rafvi-hub__core::before {
    content: '';
    position: absolute;
    inset: -14px;
    border-radius: 50%;
    border: 1px solid rgba(20, 200, 245, 0.5);
    animation: rafviRing 2.8s var(--rafvi-ease) infinite;
  }

  @keyframes rafviRing {
    0% { transform: scale(0.9); opacity: 0.8; }
    100% { transform: scale(1.25); opacity: 0; }
  }

  .rafvi-hub__core-mark {
    font-size: 1.9rem;
    font-weight: 800;
    letter-spacing: 0.02em;
    color: #fff;
  }

  .rafvi-hub__core-sub {
    font-size: 1.1rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
  }

  @media screen and (max-width: 749px) {
    .rafvi-hub {
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }
    .rafvi-hub__wires { display: none; }
    .rafvi-hub__core {
      grid-area: auto;
      grid-column: 1 / -1;
      width: 128px;
      height: 128px;
      margin-bottom: 8px;
    }
    .rafvi-hub__node:nth-child(1) { grid-area: auto; }
    .rafvi-hub__node:nth-child(2) { grid-area: auto; }
    .rafvi-hub__node:nth-child(3) { grid-area: auto; }
    .rafvi-hub__node:nth-child(4) { grid-area: auto; }
    .rafvi-hub__node:nth-child(5) { grid-area: auto; }
    .rafvi-hub__node:nth-child(6) { grid-area: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rafvi-hub__wire-signal line,
    .rafvi-hub__core::before {
      animation: none;
    }
    .rafvi-hub__wire-signal line { opacity: 0.5; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RAFVI · Omnicanal",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Una sola inteligencia. Múltiples canales." },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Centralizá llamadas, correos y mensajes en una experiencia coherente para tu empresa y tus clientes."
    }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Canal",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre", "default": "Teléfono" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RAFVI · Omnicanal",
      "blocks": [
        { "type": "channel", "settings": { "label": "Teléfono" } },
        { "type": "channel", "settings": { "label": "Email" } },
        { "type": "channel", "settings": { "label": "WhatsApp" } },
        { "type": "channel", "settings": { "label": "Web Chat" } },
        { "type": "channel", "settings": { "label": "SMS" } },
        { "type": "channel", "settings": { "label": "CRM" } }
      ]
    }
  ]
}
{% endschema %}
