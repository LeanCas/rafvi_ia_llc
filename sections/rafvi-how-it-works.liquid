<section class="rafvi-section rafvi-bg-soft" id="como-funciona">
  <div class="rafvi-container">
    <div class="rafvi-header rafvi-reveal">
      <span class="rafvi-eyebrow">Cómo funciona</span>
      <h2 class="rafvi-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="rafvi-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="rafvi-steps">
      {%- for block in section.blocks -%}
        <div class="rafvi-step rafvi-reveal" {{ block.shopify_attributes }}>
          <span class="rafvi-step__number">{{ forloop.index }}</span>
          <h3 class="rafvi-step__title">{{ block.settings.title }}</h3>
          <p class="rafvi-step__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "RAFVI · Cómo funciona",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "De tus canales a un agente inteligente en pocos pasos" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Conectá tu operación, definí las reglas y dejá que RAFVI automatice las conversaciones repetitivas mientras tu equipo mantiene el control."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Conectá" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Integrá los canales y herramientas que usa tu empresa." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "step", "settings": { "title": "Conectá", "text": "Integrá los canales y herramientas que usa tu empresa." } },
      { "type": "step", "settings": { "title": "Configurá", "text": "Definí información, reglas, tono y objetivos para el agente." } },
      { "type": "step", "settings": { "title": "Automatizá", "text": "RAFVI conversa con clientes y ejecuta tareas automáticamente." } },
      { "type": "step", "settings": { "title": "Supervisá", "text": "Tu equipo mantiene el control y recibe los casos que realmente requieren una persona." } }
    ]
  },
  "presets": [
    { "name": "RAFVI · Cómo funciona" }
  ]
}
{% endschema %}
