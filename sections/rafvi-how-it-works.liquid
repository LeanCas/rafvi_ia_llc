<section class="rafvi-section rafvi-bg-soft" id="como-funciona">
  <div class="rafvi-container">
    <div class="rafvi-header rafvi-reveal">
      <span class="rafvi-eyebrow">Cómo funciona</span>
      <h2 class="rafvi-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="rafvi-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="rafvi-steps">
      {%- for block in section.blocks -%}
        <div class="rafvi-step rafvi-reveal" {{ block.shopify_attributes }}>
          <span class="rafvi-step__number">{{ forloop.index }}</span>
          <h3 class="rafvi-step__title">{{ block.settings.title }}</h3>
          <p class="rafvi-step__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.rafvi-steps {
  position: relative;
  display: grid;
  gap: 20px;
  grid-template-columns: repeat(4, 1fr);
}
@media screen and (min-width: 990px) {
  .rafvi-steps::before {
    content: '';
    position: absolute;
    top: 54px;
    left: 12%;
    right: 12%;
    height: 2px;
    background: repeating-linear-gradient(90deg, var(--rafvi-border) 0 7px, transparent 7px 14px);
    z-index: 0;
  }
}
@media screen and (max-width: 989px) {
  .rafvi-steps { grid-template-columns: repeat(2, 1fr); }
}
@media screen and (max-width: 589px) {
  .rafvi-steps { grid-template-columns: 1fr; }
}

.rafvi-step {
  position: relative;
  z-index: 1;
  background: #fff;
  border: 1px solid var(--rafvi-border);
  border-radius: var(--rafvi-radius-lg);
  padding: 30px 26px 28px;
  box-shadow: var(--rafvi-shadow-sm);
  transition: transform 0.22s var(--rafvi-ease), box-shadow 0.22s var(--rafvi-ease);
}
.rafvi-step:hover {
  transform: translateY(-4px);
  box-shadow: var(--rafvi-shadow);
}
.rafvi-step__number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: var(--rafvi-gradient-button);
  color: #fff;
  font-weight: 800;
  font-size: 1.7rem;
  letter-spacing: -0.02em;
  margin-bottom: 22px;
  box-shadow: 0 0 0 6px rgba(11, 142, 255, 0.1);
}
.rafvi-step__title {
  font-size: 1.85rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--rafvi-text);
  margin: 0 0 8px;
}
.rafvi-step__text {
  font-size: 1.48rem;
  font-weight: 500;
  line-height: 1.62;
  color: var(--rafvi-text-secondary);
  margin: 0;
}
{% endstylesheet %}

{% schema %}
{
  "name": "RAFVI · Cómo funciona",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "De tus canales a un agente inteligente en pocos pasos" },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Conectá tu operación, definí las reglas y dejá que RAFVI automatice las conversaciones repetitivas mientras tu equipo mantiene el control."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Conectá" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Integrá los canales y herramientas que usa tu empresa." }
      ]
    }
  ],
  "presets": [
    {
      "name": "RAFVI · Cómo funciona",
      "blocks": [
        { "type": "step", "settings": { "title": "Conectá", "text": "Integrá los canales y herramientas que usa tu empresa." } },
        { "type": "step", "settings": { "title": "Configurá", "text": "Definí información, reglas, tono y objetivos para el agente." } },
        { "type": "step", "settings": { "title": "Automatizá", "text": "RAFVI conversa con clientes y ejecuta tareas automáticamente." } },
        { "type": "step", "settings": { "title": "Supervisá", "text": "Tu equipo mantiene el control y recibe los casos que realmente requieren una persona." } }
      ]
    }
  ]
}
{% endschema %}
