<section class="rafvi-section rafvi-bg-{{ section.settings.background }}" id="{{ section.id }}">
  <div class="rafvi-container">
    <div class="rafvi-columns rafvi-image-feature{% if section.settings.image_position == 'left' %} rafvi-image-feature--reverse{% endif %}">
      <div class="rafvi-image-feature__visual rafvi-reveal">
        <div class="rafvi-image-feature__glow" aria-hidden="true"></div>
        {%- if section.settings.image != blank -%}
          <img
            srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
              {{ section.settings.image | image_url: width: 700 }} 700w,
              {{ section.settings.image | image_url: width: 1000 }} 1000w"
            src="{{ section.settings.image | image_url: width: 700 }}"
            sizes="(min-width: 990px) 500px, 90vw"
            alt="{{ section.settings.image.alt | escape | default: section.settings.heading | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
            class="rafvi-image-feature__img"
          >
        {%- else -%}
          <div class="rafvi-image-feature__placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="44" height="44"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
            <span>Subí una imagen desde el editor de temas</span>
          </div>
        {%- endif -%}
      </div>

      <div class="rafvi-reveal">
        {%- if section.settings.eyebrow != blank -%}
          <span class="rafvi-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="rafvi-title">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="rafvi-subtitle rafvi-subtitle--left">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <div class="rafvi-cta-row">
            <a href="{{ section.settings.cta_link | default: '#solicitar-demo' }}" class="rafvi-btn rafvi-btn--primary">
              {{ section.settings.cta_label }}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.rafvi-columns {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 72px;
  align-items: center;
}
@media screen and (max-width: 989px) {
  .rafvi-columns { grid-template-columns: 1fr; gap: 44px; }
}
.rafvi-subtitle--left { text-align: left; }

.rafvi-image-feature--reverse { direction: rtl; }
.rafvi-image-feature--reverse > * { direction: ltr; }

.rafvi-image-feature__visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320px;
}
.rafvi-image-feature__glow {
  position: absolute;
  inset: 0;
  margin: auto;
  width: 58%;
  height: 58%;
  background: var(--rafvi-gradient);
  filter: blur(90px);
  opacity: 0.12;
  border-radius: 50%;
  z-index: 0;
}
.rafvi-image-feature__img {
  position: relative;
  z-index: 1;
  max-width: 100%;
  max-height: 440px;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
  margin: 0 auto;
}
.rafvi-image-feature__placeholder {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18px;
  width: 100%;
  height: 340px;
  border: 1px solid var(--rafvi-border);
  border-radius: var(--rafvi-radius-xl);
  background: linear-gradient(160deg, var(--rafvi-bg-soft), #fff);
  box-shadow: var(--rafvi-shadow);
  color: var(--rafvi-text-secondary);
  font-size: 1.35rem;
  font-weight: 600;
  text-align: center;
  padding: 32px;
}
.rafvi-image-feature__placeholder svg {
  width: 44px;
  height: 44px;
  padding: 14px;
  border-radius: var(--rafvi-radius-md);
  background: #fff;
  border: 1px solid var(--rafvi-border);
  color: var(--rafvi-blue);
  box-sizing: content-box;
}
{% endstylesheet %}

{% schema %}
{
  "name": "RAFVI · Imagen y texto",
  "settings": [
    {
      "type": "select",
      "id": "background",
      "label": "Fondo",
      "options": [
        { "value": "white", "label": "Blanco" },
        { "value": "soft", "label": "Gris suave" },
        { "value": "blue-soft", "label": "Celeste suave" }
      ],
      "default": "white"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen",
      "options": [
        { "value": "right", "label": "Derecha" },
        { "value": "left", "label": "Izquierda" }
      ],
      "default": "right"
    },
    { "type": "image_picker", "id": "image", "label": "Imagen (recomendado: PNG sin fondo)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "RAFVI en acción" },
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Así se ve tu operación con RAFVI" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Sumá una imagen de tu producto, tu equipo o tu operación para mostrarle a tus clientes cómo trabaja RAFVI junto a tu empresa."
    },
    { "type": "text", "id": "cta_label", "label": "Texto del CTA" },
    { "type": "url", "id": "cta_link", "label": "Link del CTA" }
  ],
  "presets": [
    { "name": "RAFVI · Imagen y texto" }
  ]
}
{% endschema %}
