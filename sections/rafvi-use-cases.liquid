<section class="rafvi-section rafvi-bg-white" id="casos-de-uso">
  <div class="rafvi-container">
    <div class="rafvi-header rafvi-reveal">
      <span class="rafvi-eyebrow">Casos de uso</span>
      <h2 class="rafvi-title">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="rafvi-subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="rafvi-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'use_case' -%}
          {%- assign items = block.settings.items | newline_to_br | split: '<br />' -%}
          <div class="rafvi-usecase-card rafvi-reveal" {{ block.shopify_attributes }}>
            <h3 class="rafvi-usecase-card__title">{{ block.settings.title }}</h3>
            <ul>
              {%- for item in items -%}
                {%- assign trimmed_item = item | strip -%}
                {%- if trimmed_item != blank -%}
                  <li>{{ trimmed_item }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.industries_heading != blank -%}
      <div class="rafvi-industries">
        <h3 class="rafvi-industries__heading rafvi-reveal">{{ section.settings.industries_heading }}</h3>
        <div class="rafvi-chip-row">
          {%- for block in section.blocks -%}
            {%- if block.type == 'industry' -%}
              <span class="rafvi-chip rafvi-chip--light rafvi-reveal" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.rafvi-usecase-card {
  background: #fff;
  border: 1px solid var(--rafvi-border);
  border-radius: var(--rafvi-radius-lg);
  padding: 28px 28px 24px;
  box-shadow: var(--rafvi-shadow-sm);
  transition: transform 0.22s var(--rafvi-ease), box-shadow 0.22s var(--rafvi-ease), border-color 0.22s ease;
}
.rafvi-usecase-card:hover {
  transform: translateY(-4px);
  border-color: var(--rafvi-electric);
  box-shadow: var(--rafvi-shadow);
}
.rafvi-usecase-card__title {
  font-size: 1.8rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--rafvi-text);
  margin: 0 0 16px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--rafvi-border);
}
.rafvi-usecase-card ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 11px;
}
.rafvi-usecase-card li {
  font-size: 1.42rem;
  font-weight: 500;
  color: var(--rafvi-text-secondary);
  padding-left: 24px;
  position: relative;
}
.rafvi-usecase-card li::before {
  content: '';
  position: absolute;
  left: 2px;
  top: 8px;
  width: 7px;
  height: 7px;
  border-radius: 2px;
  background: var(--rafvi-cyan);
  transform: rotate(45deg);
}

.rafvi-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  justify-content: center;
}
.rafvi-chip {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 12px 22px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 1.45rem;
  transition: transform 0.2s var(--rafvi-ease), background 0.2s ease, border-color 0.2s ease;
}
.rafvi-chip--light {
  background: #fff;
  border: 1px solid var(--rafvi-border);
  color: var(--rafvi-text);
  box-shadow: var(--rafvi-shadow-sm);
}
.rafvi-chip--light:hover {
  transform: translateY(-3px);
  border-color: var(--rafvi-electric);
  background: var(--rafvi-bg-soft);
}

.rafvi-industries {
  margin-top: 56px;
  text-align: center;
}
.rafvi-industries__heading {
  font-size: 1.8rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--rafvi-text);
  margin: 0 0 22px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "RAFVI · Casos de uso",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Automatización que se adapta a tu operación" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo" },
    { "type": "text", "id": "industries_heading", "label": "Encabezado de industrias", "default": "Diseñado para empresas donde cada conversación importa." }
  ],
  "blocks": [
    {
      "type": "use_case",
      "name": "Área",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Ventas" },
        { "type": "textarea", "id": "items", "label": "Ítems (uno por línea)", "default": "Calificación de leads\nContacto inicial\nSeguimiento\nAgendamiento" }
      ]
    },
    {
      "type": "industry",
      "name": "Industria",
      "settings": [
        { "type": "text", "id": "label", "label": "Nombre", "default": "Ecommerce" }
      ]
    }
  ],
  "presets": [
    {
      "name": "RAFVI · Casos de uso",
      "blocks": [
        { "type": "use_case", "settings": { "title": "Ventas", "items": "Calificación de leads\nContacto inicial\nSeguimiento\nAgendamiento" } },
        { "type": "use_case", "settings": { "title": "Soporte al cliente", "items": "Preguntas frecuentes\nEstado de pedidos o solicitudes\nEscalamiento\nEntrega de información" } },
        { "type": "use_case", "settings": { "title": "Recepción", "items": "Atención de llamadas\nCoordinación de turnos\nConsultas generales" } },
        { "type": "use_case", "settings": { "title": "Cobranzas", "items": "Recordatorios de pago\nSeguimiento\nNotificaciones a clientes" } },
        { "type": "use_case", "settings": { "title": "Operaciones internas", "items": "Flujos de comunicación repetitivos\nNotificaciones\nRuteo de información" } },
        { "type": "industry", "settings": { "label": "Ecommerce" } },
        { "type": "industry", "settings": { "label": "Clínicas" } },
        { "type": "industry", "settings": { "label": "Inmobiliarias" } },
        { "type": "industry", "settings": { "label": "Estudios profesionales" } },
        { "type": "industry", "settings": { "label": "Restaurantes" } },
        { "type": "industry", "settings": { "label": "Servicios" } },
        { "type": "industry", "settings": { "label": "Concesionarias" } }
      ]
    }
  ]
}
{% endschema %}
