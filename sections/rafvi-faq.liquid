<section class="rafvi-section rafvi-bg-soft" id="faq">
  <div class="rafvi-container">
    <div class="rafvi-header rafvi-reveal">
      <span class="rafvi-eyebrow">Preguntas frecuentes</span>
      <h2 class="rafvi-title">{{ section.settings.heading }}</h2>
    </div>

    <div class="rafvi-faq">
      {%- for block in section.blocks -%}
        <details class="rafvi-faq-item rafvi-reveal" {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <p>{{ block.settings.answer }}</p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.rafvi-faq {
  max-width: 800px;
  margin: 0 auto;
  display: grid;
  gap: 12px;
}
.rafvi-faq-item {
  border: 1px solid var(--rafvi-border);
  border-radius: var(--rafvi-radius-md);
  background: #fff;
  padding: 2px 26px;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}
.rafvi-faq-item:hover { border-color: var(--rafvi-electric); }
.rafvi-faq-item[open] {
  box-shadow: var(--rafvi-shadow-sm);
  border-color: var(--rafvi-electric);
}
.rafvi-faq-item[open] p { animation: rafviFadeIn 0.25s var(--rafvi-ease); }

@keyframes rafviFadeIn {
  from { opacity: 0; transform: translateY(-6px); }
  to { opacity: 1; transform: none; }
}

.rafvi-faq-item summary {
  list-style: none;
  cursor: pointer;
  padding: 22px 0;
  font-size: 1.55rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--rafvi-text);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}
.rafvi-faq-item summary::-webkit-details-marker { display: none; }
.rafvi-faq-item summary::after {
  content: '';
  width: 12px;
  height: 12px;
  flex-shrink: 0;
  border-right: 2px solid var(--rafvi-blue);
  border-bottom: 2px solid var(--rafvi-blue);
  transform: rotate(45deg) translate(-2px, -2px);
  transition: transform 0.2s var(--rafvi-ease);
}
.rafvi-faq-item[open] summary::after {
  transform: rotate(225deg) translate(-2px, -2px);
}
.rafvi-faq-item p {
  margin: 0 0 22px;
  font-size: 1.55rem;
  font-weight: 500;
  line-height: 1.65;
  color: var(--rafvi-text-secondary);
  max-width: 68ch;
  text-wrap: pretty;
}
{% endstylesheet %}

{% schema %}
{
  "name": "RAFVI · FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Encabezado", "default": "Preguntas frecuentes" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pregunta", "default": "¿Qué puede automatizar RAFVI?" },
        { "type": "textarea", "id": "answer", "label": "Respuesta", "default": "RAFVI puede ayudar a automatizar conversaciones y tareas relacionadas con llamadas, correos, mensajes, seguimiento, soporte y coordinación." }
      ]
    }
  ],
  "presets": [
    {
      "name": "RAFVI · FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "¿Qué puede automatizar RAFVI?", "answer": "RAFVI puede ayudar a automatizar conversaciones y tareas relacionadas con llamadas, correos, mensajes, seguimiento, soporte y coordinación." } },
        { "type": "question", "settings": { "question": "¿Puede derivar una conversación a una persona?", "answer": "Sí. El sistema puede diseñarse para escalar conversaciones cuando se necesita intervención humana." } },
        { "type": "question", "settings": { "question": "¿Puede usar información de mi empresa?", "answer": "El agente puede configurarse utilizando información, procesos y reglas autorizadas por la empresa." } },
        { "type": "question", "settings": { "question": "¿Puede trabajar fuera de horario?", "answer": "Sí. Uno de los principales beneficios de los agentes automatizados es poder responder de forma continua." } },
        { "type": "question", "settings": { "question": "¿Se puede personalizar el tono de las respuestas?", "answer": "Sí. La comunicación puede configurarse para alinearse con la identidad y forma de atención de la empresa." } },
        { "type": "question", "settings": { "question": "¿Se integra con mi CRM o herramientas actuales?", "answer": "Las integraciones dependerán del sistema utilizado y del alcance de implementación." } },
        { "type": "question", "settings": { "question": "¿Cuánto tarda una implementación?", "answer": "El tiempo de implementación depende de los canales, integraciones y nivel de personalización necesarios." } }
      ]
    }
  ]
}
{% endschema %}
