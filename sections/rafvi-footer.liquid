<footer class="rafvi-footer rafvi-bg-navy">
  <div class="rafvi-container rafvi-footer__top">
    <div class="rafvi-footer__brand">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ section.settings.logo.alt | escape | default: shop.name }}"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          style="height: {{ section.settings.logo_height }}px; width: auto;"
        >
      {%- else -%}
        <span class="rafvi-footer__wordmark">{{ section.settings.logo_text | default: shop.name }}</span>
      {%- endif -%}

      {%- if section.settings.tagline != blank -%}
        <p class="rafvi-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- if section.settings.email != blank or section.settings.linkedin_url != blank -%}
        <div class="rafvi-footer__contact">
          {%- if section.settings.email != blank -%}
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          {%- endif -%}
          {%- if section.settings.linkedin_url != blank -%}
            <a href="{{ section.settings.linkedin_url }}" target="_blank" rel="noopener">LinkedIn</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <nav class="rafvi-footer__links" aria-label="Enlaces del pie de página">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link' -%}
          <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  </div>

  <div class="rafvi-container rafvi-footer__bottom">
    <span class="rafvi-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados.</span>
  </div>
</footer>

{% stylesheet %}
  .rafvi-footer {
    padding: 72px 0 32px;
  }

  .rafvi-footer__top {
    display: flex;
    justify-content: space-between;
    gap: 48px;
    padding-bottom: 40px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
  }

  .rafvi-footer__brand {
    max-width: 360px;
  }

  .rafvi-footer__wordmark {
    font-family: 'Manrope', sans-serif;
    font-weight: 800;
    font-size: 2.2rem;
    color: #fff;
  }

  .rafvi-footer__tagline {
    margin: 16px 0 0;
    font-size: 1.5rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.6;
  }

  .rafvi-footer__contact {
    display: flex;
    gap: 20px;
    margin-top: 20px;
  }

  .rafvi-footer__contact a {
    color: #fff;
    font-weight: 600;
    font-size: 1.4rem;
    text-decoration: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
  }

  .rafvi-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
    align-content: flex-start;
    max-width: 480px;
  }

  .rafvi-footer__links a {
    color: rgba(255, 255, 255, 0.85);
    font-size: 1.45rem;
    font-weight: 600;
    text-decoration: none;
  }

  .rafvi-footer__links a:hover {
    color: var(--rafvi-cyan);
  }

  .rafvi-footer__bottom {
    display: flex;
    justify-content: flex-end;
    padding-top: 24px;
  }

  .rafvi-footer__copyright {
    font-size: 1.3rem;
    color: rgba(255, 255, 255, 0.55);
  }

  @media screen and (max-width: 749px) {
    .rafvi-footer__top {
      flex-direction: column;
      gap: 32px;
    }

    .rafvi-footer__bottom {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "RAFVI · Footer",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "range", "id": "logo_height", "label": "Alto del logo", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 32 },
    { "type": "text", "id": "logo_text", "label": "Texto (si no hay logo)", "default": "RAFVI IA LLC" },
    { "type": "textarea", "id": "tagline", "label": "Descripción breve", "default": "Agentes de IA que automatizan llamadas, correos y mensajes para empresas." },
    { "type": "text", "id": "email", "label": "Email de contacto" },
    { "type": "url", "id": "linkedin_url", "label": "LinkedIn" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Producto" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ]
}
{% endschema %}
