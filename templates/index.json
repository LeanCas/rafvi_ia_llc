    "rafvi-faq": {
      "type": "rafvi-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "¿Qué puede automatizar RAFVI?",
            "answer": "RAFVI puede ayudar a automatizar conversaciones y tareas relacionadas con llamadas, correos, mensajes, seguimiento, soporte y coordinación."
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "¿Puede derivar una conversación a una persona?",
            "answer": "Sí. El sistema puede diseñarse para escalar conversaciones cuando se necesita intervención humana."
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "¿Puede usar información de mi empresa?",
            "answer": "El agente puede configurarse utilizando información, procesos y reglas autorizadas por la empresa."
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "¿Puede trabajar fuera de horario?",
            "answer": "Sí. Uno de los principales beneficios de los agentes automatizados es poder responder de forma continua."
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "¿Se puede personalizar el tono de las respuestas?",
            "answer": "Sí. La comunicación puede configurarse para alinearse con la identidad y forma de atención de la empresa."
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "¿Se integra con mi CRM o herramientas actuales?",
            "answer": "Las integraciones dependerán del sistema utilizado y del alcance de implementación."
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "¿Cuánto tarda una implementación?",
            "answer": "El tiempo de implementación depende de los canales, integraciones y nivel de personalización necesarios."
          }
        }
      },
